<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Enable native AOSP / Infinity-X Screen-Off UDFPS & keep DozeService bound on screen-off -->
    <bool name="config_screen_off_udfps_enabled">true</bool>
    <bool name="config_screen_off_udfps_default_on">true</bool>
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>

    <!-- PD2338 RM692H5 hardware 3D-LUT Display Color Modes (QTI SDM RenderIntents):
         500 (0x1f4) = OriginOS Standard (std_sRGB / std_P3 calibrated 3D-LUT)
           0         = OriginOS Pro / Natural (sRGB / display_P3 calibrated 3D-LUT)
         502 (0x1f6) = OriginOS Vivid / Bright (native wide-gamut 3D-LUT with color management)
         Note: PD2338 HWC does NOT advertise standard RenderIntent::ENHANCE (1), so AOSP Adaptive (3) was a no-op. -->
    <integer name="config_defaultDisplayDefaultColorMode">500</integer>
    <integer-array name="config_availableColorModes">
        <item>500</item>
        <item>0</item>
        <item>502</item>
    </integer-array>

    <!-- PD2338 RM692H5 Refresh Rate & 8T LTPO defaults:
         Default peak 120 Hz keeps daily use inside HWC group 0 (60/72/90/120 Hz 360Hz High-TE seamless LTPO),
         while 144 Hz (HWC group 1) is selectable in Settings / Per-App / Extreme Refresh Rate via allowGroupSwitching. -->
    <integer name="config_defaultPeakRefreshRate">120</integer>
    <integer name="config_defaultRefreshRate">0</integer>
    <bool name="config_supportsSeamlessRefreshRateSwitching">true</bool>

    <!-- Enable Adaptive / Automatic Brightness (stock OriginOS 4 defines this in /product, not /vendor) -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer name="config_autoBrightnessBrighteningLightDebounce">1500</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">4000</integer>
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">102</integer>
    <integer name="config_screenBrightnessDim">10</integer>

